# Server-side only. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=

# Model used for segmentation, meaning checks and the final review.
OPENAI_MODEL=gpt-5.4-mini
# Reasoning effort for reasoning-capable models (none|minimal|low|medium|high). Set to "off" for models that do not accept it.
OPENAI_REASONING_EFFORT=low
# Model used by the optional server-side transcription provider.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Optional: point at an OpenAI-compatible endpoint (also used by the e2e test's mock server).
# OPENAI_BASE_URL=

# Development/testing only: exposes the simulated speech provider (?speech=simulated).
# NEXT_PUBLIC_ENABLE_SIMULATED_SPEECH=1
